# Homebrew formula for the paxel/tap tap, generated by the release workflow: it fills
# in the tagged version and the sha256 of each release tarball and pushes the result
# to the homebrew-tap repository as Formula/whiteboxed.rb. Binary formula.
class Whiteboxed < Formula
  desc "WYSIWYG editor for arc42 building-block views"
  homepage "https://github.com/paxel/whiteboxed"
  version "{{VERSION}}"
  license "MIT"

  on_macos do
    if Hardware::CPU.arm?
      url "https://github.com/paxel/whiteboxed/releases/download/v{{VERSION}}/whiteboxed-{{VERSION}}-macos-arm64.tar.gz"
      sha256 "{{SHA_MACOS_ARM64}}"
    else
      url "https://github.com/paxel/whiteboxed/releases/download/v{{VERSION}}/whiteboxed-{{VERSION}}-macos-x86_64.tar.gz"
      sha256 "{{SHA_MACOS_X86_64}}"
    end
  end

  on_linux do
    url "https://github.com/paxel/whiteboxed/releases/download/v{{VERSION}}/whiteboxed-{{VERSION}}-linux-x86_64.tar.gz"
    sha256 "{{SHA_LINUX_X86_64}}"
  end

  def install
    bin.install "whiteboxed"
    return unless OS.linux?

    # The launcher entry, its icons and the helper that installs them live together,
    # so the helper finds the files next to itself.
    libexec.install "io.github.paxel.whiteboxed.desktop", "install-icon.sh",
                    "icon_256.png", "icon.svg"

    # An absolute Exec: a desktop session does not read Homebrew's shell environment,
    # so its bin directory is not on the session's PATH. The icon stays the theme
    # name "whiteboxed": post_install puts the PNG into ~/.local/share/icons.
    inreplace libexec/"io.github.paxel.whiteboxed.desktop" do |entry|
      entry.gsub! "Exec=whiteboxed", "Exec=#{opt_bin}/whiteboxed"
    end

    (libexec/"install-icon.sh").chmod 0755
    (bin/"whiteboxed-install-icon").write <<~SH
      #!/bin/sh
      exec "#{opt_libexec}/install-icon.sh" "$@"
    SH
    (bin/"whiteboxed-install-icon").chmod 0755

    # Also in Homebrew's own share, for the sessions that do read it.
    (share/"applications").mkpath
    cp libexec/"io.github.paxel.whiteboxed.desktop", share/"applications/io.github.paxel.whiteboxed.desktop"
    (share/"icons/hicolor/256x256/apps").mkpath
    cp libexec/"icon_256.png", share/"icons/hicolor/256x256/apps/whiteboxed.png"
  end

  # Homebrew's share directory is not on a desktop session's XDG_DATA_DIRS, so the
  # entry above alone stays invisible to menus. Homebrew on Linux runs this step
  # outside a sandbox, so the launcher entry and the icons go into ~/.local/share here,
  # which every session reads. A home that cannot be written (a container, a bottle
  # build) must not fail the install over a menu entry.
  def post_install
    return unless OS.linux?

    system libexec/"install-icon.sh"
  rescue ErrorDuringExecution
    opoo "The launcher entry could not be installed; run whiteboxed-install-icon yourself."
  end

  def caveats
    return unless OS.linux?

    <<~EOS
      Needs the usual desktop libraries from your distribution: X11 or Wayland
      with libxkbcommon (e.g. Debian/Ubuntu: sudo apt install libxkbcommon0).

      The install puts whiteboxed into your application menu under ~/.local/share.
      If it is missing there, for another user on this machine, or with a custom
      XDG_DATA_HOME, run:

        whiteboxed-install-icon

      Before brew uninstall, to take the menu entry out again:

        whiteboxed-install-icon --uninstall
    EOS
  end

  test do
    assert_predicate bin/"whiteboxed", :executable?
  end
end
